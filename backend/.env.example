# Copie para .env e preencha. O .env NUNCA vai para o git.

NODE_ENV=development
HOST=127.0.0.1
PORT=3333

# Vazio = Postgres embutido (PGlite) gravando em PGLITE_DIR — bom para dev.
# Produção (VPS): postgres://usuario:senha@localhost:5432/clivra
DATABASE_URL=
PGLITE_DIR=./.pgdata

# Segredo que assina o accessToken. Mínimo 32 caracteres, aleatório.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Origens do front permitidas (CORS), separadas por vírgula. Sem "*".
CORS_ORIGINS=http://localhost:5173

# Cookie do refresh token só via HTTPS. Em produção SEMPRE true.
COOKIE_SECURE=false

# Atrás de proxy: NÚMERO de proxies na frente (Vercel + Caddy = 2) ou lista de
# IPs confiáveis. "true" não é aceito (deixaria o IP forjável). Dev: false.
TRUST_PROXY=false

# Código para criar a conta do dono (mín. 16 caracteres). Em produção é
# obrigatório: sem ele o cadastro fica fechado. Em dev, vazio = sem código.
# Gere com: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
OWNER_SETUP_CODE=
