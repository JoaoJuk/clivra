# /etc/systemd/system/clivra-hml.service — API do CLIVRA, HOMOLOGAÇÃO.
# Usuário, banco e segredos próprios: comprometer a homologação não alcança produção.
[Unit]
Description=CLIVRA API (homologação)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=clivra_hml
Group=clivra_hml
EnvironmentFile=/etc/clivra/clivra-hml.env
WorkingDirectory=/opt/clivra-hml/current
ExecStart=/opt/node/bin/node dist/server.js
Restart=on-failure
RestartSec=3

# Isolamento: o processo não escreve em disco, não vê /home, não ganha privilégio.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
MemoryMax=512M

[Install]
WantedBy=multi-user.target
